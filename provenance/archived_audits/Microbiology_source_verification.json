  "variable_labels": {
    "age": {
      "label": "Age group",
      "definition": "Adult or pediatric source population"
    },
    "period": {
      "label": "Reporting period",
      "definition": "Published source interval"
    },
    "category": {
      "label": "Surgical category or SSI depth",
      "definition": "Original source category. AMR tables also contain depth strata; all-procedure totals overlap component categories"
    },
    "pathogen": {
      "label": "Organism",
      "definition": "Published species or group, harmonized spelling only; retain source taxonomy differences"
    },
    "count": {
      "label": "Pathogen reports",
      "definition": "Exact published organism report count; depth datasets count pathogen reports classified by SSI depth"
    },
    "total": {
      "label": "Total pathogen reports in stratum",
      "definition": "Composition denominator repeated across components; never sum repeated denominators"
    },
    "proportion": {
      "label": "Share of pathogen reports",
      "definition": "Count divided by total pathogen reports in its source stratum"
    },
    "depth": {
      "label": "SSI depth",
      "definition": "Superficial incisional, deep incisional or organ/space; all-SSI total overlaps these components"
    },
    "ssi_events": {
      "label": "SSI events",
      "definition": "Published number of SSI events in source population; can have multiple pathogen reports"
    },
    "pathogen_reports": {
      "label": "Pathogen reports",
      "definition": "Published number of organism reports, not unique patients or operations"
    },
    "ssi_events_without_pathogen": {
      "label": "SSI events without reported pathogen",
      "definition": "Source events without a reported organism, blank when unavailable"
    },
    "ssi_events_with_pathogen": {
      "label": "SSI events with reported pathogen",
      "definition": "Source events minus events without a reported organism"
    },
    "fraction_without_pathogen": {
      "label": "Share of SSI events without reported pathogen",
      "definition": "Events without reported pathogen divided by all SSI events"
    },
    "reported_count": {
      "label": "Reported organism count",
      "definition": "Source count of organism reports before drug-specific testing; repeated across phenotypes"
    },
    "percent_tested": {
      "label": "Organism reports tested (%)",
      "definition": "Published rounded percentage of reported organism count tested for phenotype"
    },
    "percent_result": {
      "label": "Resistance or non-susceptibility (%)",
      "definition": "Published rounded phenotype percentage among tested organism reports, not among all SSI events"
    },
    "phenotype": {
      "label": "Antimicrobial or resistance phenotype",
      "definition": "Source-specific definition retained, including footnote variants"
    },
    "measure": {
      "label": "Phenotype measure",
      "definition": "Resistance or non-susceptibility according to source definition"
    },
    "source_significant_vs_abdominal": {
      "label": "Source comparison significant vs abdominal",
      "definition": "Original source significance flag in 2015-2017, not a new test"
    },
    "source_p_threshold": {
      "label": "Source P value threshold",
      "definition": "0.05 when source significance flag is present; blank otherwise"
    },
    "compatible_tested_min": {
      "label": "Minimum compatible tested reports",
      "definition": "Derived minimum integer compatible with rounded tested percentage; not exact source count"
    },
    "compatible_tested_max": {
      "label": "Maximum compatible tested reports",
      "definition": "Derived maximum integer compatible with rounded tested percentage; not exact source count"
    },
    "compatible_result_min": {
      "label": "Minimum compatible phenotype reports",
      "definition": "Derived minimum phenotype count compatible with both published percentages; not exact source count"
    },
    "compatible_result_max": {
      "label": "Maximum compatible phenotype reports",
      "definition": "Derived maximum phenotype count compatible with both published percentages; not exact source count"
    },
    "rounding_aware_wilson_lower": {
      "label": "Rounding-aware 95% CI lower",
      "definition": "Minimum Wilson lower bound across compatible integer numerator-denominator pairs"
    },
    "rounding_aware_wilson_upper": {
      "label": "Rounding-aware 95% CI upper",
      "definition": "Maximum Wilson upper bound across compatible integer numerator-denominator pairs"
    },
    "compatible_integer_pairs": {
      "label": "Compatible integer pairs",
      "definition": "Number of tested-positive integer pairs satisfying nearest 0.1 percentage-point rounding"
    },
    "exact_tested_count_available": {
      "label": "Exact tested count available",
      "definition": "False for every AMR source cell"
    },
    "primary_cross_period_comparability": {
      "label": "Primary cross-period comparison permitted",
      "definition": "False for period-shifted Klebsiella and Enterobacter definitions"
    },
    "profile_id": {
      "label": "Microbiology profile ID",
      "definition": "Age group, period and source surgical category; other procedures computed as residual of all-surgery total"
    },
    "ecotype": {
      "label": "Pathogen profile group",
      "definition": "Discovery-fitted compositional group assigned with frozen discovery definitions"
    },
    "n_pathogen_reports": {
      "label": "Pathogen reports in profile",
      "definition": "Non-overlapping profile composition denominator after exact residual categories"
    },
    "residual_profile": {
      "label": "Other-procedure residual profile",
      "definition": "True where source all-procedure total minus represented category totals was used"
    },
    "role": {
      "label": "Study role",
      "definition": "Discovery for 2015-2017; later evaluation for 2018-2021"
    },
    "PC1": {
      "label": "Projection dimension 1",
      "definition": "Score from discovery-fitted centered-log-ratio PCA"
    },
    "PC2": {
      "label": "Projection dimension 2",
      "definition": "Score from discovery-fitted centered-log-ratio PCA"
    },
    "source_table": {
      "label": "Source table",
      "definition": "Table in age-period source document identified by source metadata"
    }
  },
